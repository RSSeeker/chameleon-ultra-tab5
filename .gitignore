# ---------------------------------------------------------------------------
# Build output. `idf.py build` writes ~300 MB here; nothing in it belongs in git.
# ---------------------------------------------------------------------------
build/
firmware/build/
*.bin
*.elf
*.map
compile_commands.json

# Generated by `idf.py menuconfig` from sdkconfig.defaults. The defaults are the
# checked-in source of truth; this file is per-machine.
sdkconfig
sdkconfig.old

# Regenerated by the ESP-IDF component manager; it records absolute paths of the
# machine that ran the build, so it is not portable.
firmware/dependencies.lock

# ---------------------------------------------------------------------------
# Third-party components are vendored under firmware/components/ so the build
# works without network access (see README section 5). The bulk of LVGL's
# demos/ and examples/ is left out because nothing in the build compiles it,
# but both directories themselves must exist: LVGL's esp.cmake passes them to
# idf_component_register() as include directories unconditionally. Each keeps a
# .gitkeep explaining that.
# ---------------------------------------------------------------------------
firmware/components/lvgl__lvgl/demos/*
!firmware/components/lvgl__lvgl/demos/.gitkeep
firmware/components/lvgl__lvgl/examples/*
!firmware/components/lvgl__lvgl/examples/.gitkeep
firmware/components/lvgl__lvgl/env_support/cmsis-pack/

# ---------------------------------------------------------------------------
# Host-side probes. Tools/ is committed; their scratch output and compiled
# harnesses are not.
# ---------------------------------------------------------------------------
.probe/
__pycache__/
*.pyc

# ---------------------------------------------------------------------------
# Scratch files from early bring-up. Superseded by tools/capture_console.py and
# by rebooting the board by hand (the notes explain why nothing here should
# toggle DTR/RTS).
# ---------------------------------------------------------------------------
*.log
read_serial.py
reset_boot.py

# Editors / OS
.vscode/
.idea/
Thumbs.db
desktop.ini
